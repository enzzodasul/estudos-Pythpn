# 25. COMPOSIÇÃO
# 25. COMPOSITION
# ============================================================

# PT: Composição permite que uma classe tenha objetos de outra classe.
# EN: Composition allows a class to contain objects of another class.

class Motor:

    def ligar(self):
        print("Motor ligado!")


class Carro:

    def __init__(self):
        self.motor = Motor()

    def ligar_carro(self):
        self.motor.ligar()


carro1 = Carro()

carro1.ligar_carro()


