cachorro1.latir()


# ============================================================
# 22. SUPER()
# 22. SUPER()
# ============================================================

# PT: super() permite acessar métodos da classe pai.
# EN: super() allows access to methods from the parent class.

class Animal:

    def __init__(self, nome):
        self.nome = nome


class Cachorro(Animal):

    def __init__(self, nome, raca):
        super().__init__(nome)
        self.raca = raca


cachorro1 = Cachorro("Rex", "Labrador")

print(cachorro1.nome)
print(cachorro1.raca)


