# 23. SOBRESCRITA DE MÉTODOS
# 23. METHOD OVERRIDING
# ============================================================

# PT: Uma classe filha pode redefinir um método da classe pai.
# EN: A child class can redefine a method from the parent class.

class Animal:

    def emitir_som(self):
        print("Som do animal.")


class Cachorro(Animal):

    def emitir_som(self):
        print("Au au!")


cachorro1 = Cachorro()

cachorro1.emitir_som()


# ============================================================
# 24. POLIMORFISMO
# 24. POLYMORPHISM
# ============================================================

# PT: Objetos diferentes podem responder ao mesmo método
# de maneiras diferentes.
#
# EN: Different objects can respond to the same method
# in different ways.

class Cachorro:

    def emitir_som(self):
        print("Au au!")


class Gato:

    def emitir_som(self):
        print("Miau!")


animais = [Cachorro(), Gato()]

for animal in animais:
    animal.emitir_som()


