# ============================================================
# 21. HERANÇA COM CONSTRUTOR
# 21. INHERITANCE WITH CONSTRUCTOR
# ============================================================

class Animal:

    def __init__(self, nome):
        self.nome = nome


class Cachorro(Animal):

    def latir(self):
