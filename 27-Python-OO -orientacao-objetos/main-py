# 13. ATRIBUTOS DE CLASSE
# 13. CLASS ATTRIBUTES
# ============================================================

# PT: Atributos de classe são compartilhados pela classe e instâncias,
# salvo quando uma instância define seu próprio atributo com o mesmo nome.
#
# EN: Class attributes are shared by the class and instances,
# unless an instance defines its own attribute with the same name.

class Pessoa:

    especie = "Humano"

    def __init__(self, nome):
        self.nome = nome


pessoa1 = Pessoa("Enzo")
pessoa2 = Pessoa("Ana")

print(pessoa1.especie)
print(pessoa2.especie)


