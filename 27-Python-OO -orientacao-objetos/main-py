# ============================================================
# 15. MÉTODOS ESTÁTICOS — @staticmethod
# 15. STATIC METHODS — @staticmethod
# ============================================================

# PT: Métodos estáticos não recebem self ou cls automaticamente.
# EN: Static methods do not automatically receive self or cls.

class Matematica:

    @staticmethod
    def somar(a, b):
        return a + b


print(Matematica.somar(10, 20))


# ============================================================
# 16. ENCAPSULAMENTO
# 16. ENCAPSULATION
# ============================================================

# PT: Encapsulamento organiza e controla o acesso aos dados.
# EN: Encapsulation organizes and controls access to data.

class Conta:

    def __init__(self, saldo):
        self._saldo = saldo

    def consultar_saldo(self):
        return self._saldo


conta1 = Conta(1000)

print(conta1.consultar_saldo())

# PT: O underline indica que o atributo é de uso interno por convenção.
# EN: The underscore indicates that the attribute is intended for
# internal use by convention.


# ============================================================
# 17. ATRIBUTOS COM DOIS UNDERLINES
# 17. DOUBLE UNDERSCORE ATTRIBUTES
# ============================================================

# PT: __saldo ativa o name mangling para evitar colisões de nomes.
# EN: __saldo activates name mangling to help avoid name collisions.

class Conta:

    def __init__(self, saldo):
        self.__saldo = saldo

    def consultar_saldo(self):
        return self.__saldo


conta1 = Conta(500)

print(conta1.consultar_saldo())

# PT: Isso não é privacidade absoluta, mas dificulta acesso acidental.
# EN: This is not absolute privacy, but it discourages accidental access.


# ============================================================
# 18. PROPRIEDADES — @property
# 18. PROPERTIES — @property
# ============================================================

# PT: @property permite acessar um método como se fosse um atributo.
# EN: @property lets us access a method as if it were an attribute.

class Produto:

    def __init__(self, preco):
        self._preco = preco

    @property
    def preco(self):
        return self._preco


produto1 = Produto(100)

print(produto1.preco)


# ============================================================
# 19. PROPERTY COM SETTER
# 19. PROPERTY WITH SETTER
# ============================================================

class Produto:

    def __init__(self, preco):
        self._preco = preco

    @property
    def preco(self):
        return self._preco

    @preco.setter
    def preco(self, novo_preco):

        if novo_preco < 0:
            raise ValueError("O preço não pode ser negativo.")

        self._preco = novo_preco


produto1 = Produto(100)

produto1.preco = 150

print(produto1.preco)


