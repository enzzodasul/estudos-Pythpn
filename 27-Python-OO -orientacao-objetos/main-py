# 20. INHERITANCE
# ============================================================

# PT: Herança permite criar uma classe baseada em outra.
# EN: Inheritance allows creating a class based on another.

class Animal:

    def comer(self):
        print("O animal está comendo.")


class Cachorro(Animal):
